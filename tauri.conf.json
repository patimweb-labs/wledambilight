{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WLED Ambilight",
  "version": "0.3.0",
  "identifier": "io.github.smotherer007.WledAmbilight",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WLED Ambilight",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "backgroundColor": "#060A12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "assets/icons/icon-32.png",
      "assets/icons/icon-128.png",
      "assets/icons/icon-256.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libgtk-3-0",
          "gstreamer1.0-tools",
          "gstreamer1.0-pipewire",
          "gstreamer1.0-plugins-base",
          "xdg-desktop-portal"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libayatana-appindicator-gtk3",
          "gtk3",
          "gstreamer1-plugins-base",
          "pipewire-gstreamer",
          "xdg-desktop-portal"
        ]
      }
    }
  }
}
